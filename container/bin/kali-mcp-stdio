#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: kali-mcp-stdio [mcp-server args...]

Starts a local kali-server-mcp API server on a loopback port, waits for it to
become reachable, then runs mcp-server as a stdio MCP bridge.

Environment:
  KALI_MCP_HOST       API bind host (default: 127.0.0.1)
  KALI_MCP_PORT       API port (default: random free port)
  KALI_MCP_TIMEOUT    mcp-server request timeout seconds (default: 300)
  KALI_MCP_LOG_FILE   API server log file (default: /tmp/kali-mcp-<port>.log)
USAGE
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

choose_port() {
  python3 - <<'PY'
import socket
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
}

require_command kali-server-mcp
require_command mcp-server

HOST="${KALI_MCP_HOST:-127.0.0.1}"
PORT="${KALI_MCP_PORT:-$(choose_port)}"
TIMEOUT="${KALI_MCP_TIMEOUT:-300}"
LOG_FILE="${KALI_MCP_LOG_FILE:-/tmp/kali-mcp-${PORT}.log}"
SERVER_URL="http://${HOST}:${PORT}"

kali-server-mcp --ip "$HOST" --port "$PORT" >"$LOG_FILE" 2>&1 &
api_pid=$!

cleanup() {
  kill "$api_pid" >/dev/null 2>&1 || true
  wait "$api_pid" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

python3 - "$HOST" "$PORT" "$LOG_FILE" <<'PY'
import socket
import sys
import time

host, port, log_file = sys.argv[1], int(sys.argv[2]), sys.argv[3]
deadline = time.monotonic() + 20
while time.monotonic() < deadline:
    try:
        with socket.create_connection((host, port), timeout=1):
            sys.exit(0)
    except OSError:
        time.sleep(0.2)
print(f"kali-server-mcp did not become ready on {host}:{port}; log: {log_file}", file=sys.stderr)
sys.exit(1)
PY

mcp-server --server "$SERVER_URL" --timeout "$TIMEOUT" "$@"
