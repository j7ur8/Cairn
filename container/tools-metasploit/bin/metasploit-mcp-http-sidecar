#!/usr/bin/env bash
set -euo pipefail

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

choose_port() {
  python3 - <<'PY'
import socket
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
}

random_password() {
  python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(32))
PY
}

wait_for_port() {
  local host="$1"
  local port="$2"
  local deadline=$((SECONDS + 90))
  until python3 - "$host" "$port" <<'PY'
import socket
import sys
host = sys.argv[1]
port = int(sys.argv[2])
try:
    with socket.create_connection((host, port), timeout=1):
        sys.exit(0)
except OSError:
    sys.exit(1)
PY
  do
    if [[ "$SECONDS" -ge "$deadline" ]]; then
      echo "timed out waiting for msfrpcd on ${host}:${port}" >&2
      return 1
    fi
    sleep 1
  done
}

cleanup() {
  if [[ -n "${MSFRPCD_PID:-}" ]] && kill -0 "$MSFRPCD_PID" >/dev/null 2>&1; then
    kill "$MSFRPCD_PID" >/dev/null 2>&1 || true
    wait "$MSFRPCD_PID" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

require_command metasploitmcp
require_command msfrpcd

export MSF_SERVER="${MSF_SERVER:-127.0.0.1}"
export MSF_PORT="${MSF_PORT:-$(choose_port)}"
export MSF_PASSWORD="${MSF_PASSWORD:-$(random_password)}"
export MSF_SSL="${MSF_SSL:-false}"

msfrpcd -f -S -a "$MSF_SERVER" -p "$MSF_PORT" -P "$MSF_PASSWORD" >&2 &
MSFRPCD_PID=$!
wait_for_port "$MSF_SERVER" "$MSF_PORT"

exec /usr/local/bin/mcp-stdio-http-bridge \
  --listen "${METASPLOIT_MCP_HTTP_HOST:-0.0.0.0}:${METASPLOIT_MCP_HTTP_PORT:-8775}" \
  -- metasploitmcp --transport stdio
