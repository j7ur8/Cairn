# Cairn dispatcher secrets and per-deployment overrides.
# Copy to `.env` and fill in real values; .env is git-ignored.
# docker-compose.yaml injects this file into the cairn-dispatcher container.

# --- Worker: claudecode_deepseek-v4-pro (active in dispatch.yaml) ---
ANTHROPIC_AUTH_TOKEN=sk-REPLACE-ME

# --- Worker: codex (commented out in dispatch.yaml; uncomment to enable) ---
OPENAI_API_KEY=sk-REPLACE-ME

# --- Remote SSH support (optional; leave empty to disable) ---
# All three are required to actually enable SSH. Empty values (or leaving them
# unset) make RemoteSupportConfig.ssh.is_complete stay False.
# CAIRN_REMOTE_SSH_HOST=1.2.3.4
# CAIRN_REMOTE_SSH_USERNAME=ubuntu
# CAIRN_REMOTE_SSH_PASSWORD=

# --- HTTP MCP bearer token (only used by transport: "http" mcp_servers) ---
# MCP_AUTH_TOKEN=sk-REPLACE-ME

# SECURITY:
# - .env must NEVER be committed. .gitignore and .dockerignore already exclude it.
# - Do NOT copy .env contents into issue trackers, chat, email, screenshots, CI logs.
# - Rotate MCP_AUTH_TOKEN and other secrets regularly; in-flight workers may
#   continue using the old token until they recycle (see container.completed_action
#   in dispatch.yaml and DispatcherLoop.cleanup_completed).

# --- JWT auth (server-side) ---
# CAIRN_JWT_SECRET is used by the server to sign and verify JWTs. It MUST
# be set in any non-dev deployment. CAIRN_SECRETS_KEY is accepted as a
# fallback so existing single-secret deployments keep working.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# CAIRN_JWT_SECRET=
# CAIRN_SECRETS_KEY=

# --- Initial superuser (only consumed on first server start) ---
# CAIRN_INITIAL_ADMIN_EMAIL=admin@example.com
# CAIRN_INITIAL_ADMIN_PASSWORD=change-me-on-first-login

# --- API token for the dispatcher -> server calls ---
# A long-lived service-account JWT. Mint with:
#   python -c "from cairn.server.security.jwt import issue_token; print(issue_token('dispatcher-service'))"
# Both the dispatcher container and the server must agree on the same
# CAIRN_JWT_SECRET, and the token must be issued with that same secret.
# CAIRN_API_TOKEN=
